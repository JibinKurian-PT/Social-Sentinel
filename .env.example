# ============================================================
# .env.example – Social Sentiment System
# Copy to .env and fill in real values before starting
# ============================================================

# ── Twitter API v2 (get from developer.twitter.com) ────────────────────────
TWITTER_BEARER_TOKEN=REPLACE_WITH_YOUR_BEARER_TOKEN
TWITTER_API_KEY=REPLACE_WITH_YOUR_API_KEY
TWITTER_API_SECRET=REPLACE_WITH_YOUR_API_SECRET
TWITTER_ACCESS_TOKEN=REPLACE_WITH_YOUR_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=REPLACE_WITH_YOUR_ACCESS_SECRET

# ── YouTube Data API v3 (get from console.cloud.google.com) ────────────────
YOUTUBE_API_KEY=REPLACE_WITH_YOUR_YOUTUBE_API_KEY

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# IMPORTANT: Use a strong password in production (not 'postgres')
POSTGRES_USER=sentiment_user
POSTGRES_PASSWORD=Ch@ngeM3_Str0ng!
POSTGRES_DB=sentiment_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Literal URL (do NOT use ${VAR} shell interpolation – Python dotenv won't expand it)
DATABASE_URL=postgresql+asyncpg://sentiment_user:Ch@ngeM3_Str0ng!@postgres:5432/sentiment_prod

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=sentiment_raw

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── API Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=REPLACE_WITH_A_LONG_RANDOM_HEX_STRING
API_KEY_ENABLED=true

# ── Ports ────────────────────────────────────────────────────────────────────
API_PORT=8000
DASHBOARD_PORT=8501

# ── HuggingFace / NLP ────────────────────────────────────────────────────────
BERT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
# Path where models are cached inside the container
HF_HOME=/app/.cache/huggingface

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Mock Mode (set true if no real API keys yet) ─────────────────────────────
MOCK_COLLECTORS=true
